enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
  ACCOUNTANT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id         String  @id @default(uuid())
  email      String  @unique
  password   String
  fullName   String
  role       Role  @default(ADMIN)
  profileImg String?
  isActive   Boolean @default(true)

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //relations
  refreshTokens RefreshToken[]
  student       Student?

  @@index([role])
  @@index([schoolId])
  @@index([schoolId, role])
  @@map("users")
}

model School {
  id       String  @id @default(uuid())
  name     String  @unique
  slug     String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  academicSessions AcademicSession[]
  students         Student[]

  @@map("schools")
}

model AcademicSession {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  academicYear String
  isCurrent    Boolean @default(false)

  startDate DateTime
  endDate   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, academicYear])
  @@map("academic_sessions")
}

// Refresh tokens are stored (hashed) so they can be revoked server-side.
model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("refresh_tokens")
}

model Student {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  gender      Gender?
  dateOfBirth DateTime? @db.Date
  bloodGroup  String?

  admissionDate   DateTime @default(now())
  admissionNumber String
  previousSchool  String?

  streetAddress String?
  city          String?
  district      String?
  country       String?

  fatherName        String?
  fatherPhone       String?
  motherName        String?
  motherPhone       String?
  guardianName      String?
  guardianPhone     String?
  relationToStudent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
  @@map("students")
}
